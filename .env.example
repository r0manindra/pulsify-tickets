# App
PORT=3000
NODE_ENV=development
API_ADMIN_SECRET=change-me-admin-secret
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pulsify_tickets

# Stripe Connect
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Auth — verifies Supabase-issued access tokens (the Pulsify user JWT).
# SUPABASE_JWT_SECRET: project JWT secret (Supabase dashboard -> Settings -> API).
# SUPABASE_URL: project URL; the issuer is derived as <SUPABASE_URL>/auth/v1.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
# Overrides (defaults: audience=authenticated, algorithm=HS256, issuer from SUPABASE_URL)
# JWT_ISSUER=
# JWT_AUDIENCE=authenticated
# JWT_ALGORITHM=HS256
